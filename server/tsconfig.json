{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "rootDir": "src", "outDir": "dist", "esModuleInterop": true,
    "resolveJsonModule": true, "strict": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node"]
  }, "include": ["src/**/*.ts"]
}
